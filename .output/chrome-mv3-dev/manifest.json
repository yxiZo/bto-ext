{
  "manifest_version": 3,
  "name": "BT0 Extension",
  "description": "Mukaku detail-page side panel assistant.",
  "version": "0.0.0",
  "permissions": [
    "sidePanel",
    "tabs",
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.115.com/*",
    "https://web5.mukaku.com/*",
    "http://web5.mukaku.com/*",
    "https://www.0bt0.com/*",
    "http://www.0bt0.com/*",
    "https://www.1bt0.com/*",
    "http://www.1bt0.com/*",
    "https://www.2bt0.com/*",
    "http://www.2bt0.com/*",
    "https://www.3bt0.com/*",
    "http://www.3bt0.com/*",
    "https://www.4bt0.com/*",
    "http://www.4bt0.com/*",
    "https://www.5bt0.com/*",
    "http://www.5bt0.com/*",
    "https://www.6bt0.com/*",
    "http://www.6bt0.com/*",
    "https://www.7bt0.com/*",
    "http://www.7bt0.com/*",
    "https://www.8bt0.com/*",
    "http://www.8bt0.com/*",
    "https://www.9bt0.com/*",
    "http://www.9bt0.com/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "BT0 Extension"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://localhost:3000; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  }
}